# Local-first default runtime
JARVIS_API_HOST=127.0.0.1
JARVIS_API_PORT=8765
JARVIS_REQUEST_STARTUP_PERMISSIONS=0
JARVIS_REQUEST_STARTUP_ADMIN=0

# Optional: set a fixed API token for LAN or remote clients.
# If omitted, Jarvis generates an ephemeral token at startup and stores it in
# local runtime metadata for trusted local tools like jarvis_cli.py.
JARVIS_API_TOKEN=

# Local model defaults
LOCAL_DEFAULT_MODEL=glm-4.7-flash
LOCAL_CODER_MODEL=glm-4.7-flash
LOCAL_REASONING_MODEL=glm-4.7-flash

# TTS backend priority: kokoro (local neural) → say (macOS) → elevenlabs → openai
# Kokoro is the recommended local-first backend — no API key required.
JARVIS_TTS_BACKENDS=kokoro,say,elevenlabs,openai

# Kokoro TTS settings
# Voice options: bm_george (polished British male), am_onyx, af_sarah, af_bella
JARVIS_KOKORO_TTS_ENABLED=1
JARVIS_KOKORO_VOICE=bm_george
JARVIS_KOKORO_SPEED=0.94
JARVIS_LOCAL_TTS_VOICE=Daniel
JARVIS_LOCAL_TTS_RATE_WPM=168

# Optional cloud fallbacks
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
